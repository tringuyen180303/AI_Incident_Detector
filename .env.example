# Leave these unset to use the Postgres started by docker compose.
# Set both to write incidents to your own Supabase project instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Without it, the incident summary is a fixed sentence.
# Put the key in .env, which is gitignored. Leave this example empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Kafka topic sizes. Raise TELEMETRY_PARTITIONS before you add more detectors.
TELEMETRY_PARTITIONS=12
ANOMALY_PARTITIONS=3


