# Leave this empty when the board and the engine run together.
# Set it when the engine is on another machine.
INCIDENT_API_URL=

# Vercel. Set both in the project settings. These are server-only.
# Do not prefix them with NEXT_PUBLIC_. The service role bypasses row
# level security, so it must never ship to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
